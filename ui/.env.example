# ---------------------------------------------------------------------------
# Real Aetherion/milkyway API (test-suite-list etc.) — proxied via /rapi/<env>
# so the browser stays same-origin (avoids CORS from the token's allowed-origins).
# These are read by next.config.ts at startup; restart `next` after changing.
# Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Local platform API base (the :8001 gateway from your curl)
ACT_LOCAL_API_URL=http://localhost:8001/api/v1

# Sbox platform API base (confirm the real host; leave blank to disable the sbox env)
ACT_SBOX_API_URL=https://calfus.sbox.aetherion.io/api/v1
